{
  "manifest_version": 3,
  "name": "Top Hat Watch",
  "version": "2.2",
  "description": "Alerts you when the instructor pushes anything in Top Hat: questions, attendance, presented items.",
  "permissions": [
    "notifications",
    "storage",
    "alarms",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "https://app.tophat.com/*",
    "https://ntfy.sh/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.tophat.com/*"
      ],
      "js": [
        "ws-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.tophat.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Pause/resume alerts"
    }
  }
}